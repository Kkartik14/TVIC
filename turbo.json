{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["TVIC_RUN_INTEGRATION", "DATABASE_URL", "MEMORY_INTEGRATION_URL", "REDIS_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
