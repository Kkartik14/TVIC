{
  "name": "tvic",
  "private": true,
  "version": "0.0.0",
  "description": "TVIC: a provider-neutral TypeScript runtime for realtime voice agents.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm format:check && pnpm typecheck && node scripts/check-architecture.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
