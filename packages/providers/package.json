{
  "name": "@tvic/providers",
  "version": "0.1.0",
  "description": "T-vic provider contract utilities for capability checks and provider kind narrowing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tvic/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
