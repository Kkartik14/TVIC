{
  "name": "voice-runtime",
  "version": "1.0.1",
  "description": "Local-first, provider-neutral runtime for realtime voice agents, powered by TVIC.",
  "type": "module",
  "bin": {
    "voice-runtime": "./bin/voice-runtime.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kkartik14/TVIC.git",
    "directory": "packages/voice-runtime"
  },
  "homepage": "https://github.com/Kkartik14/TVIC#readme",
  "bugs": {
    "url": "https://github.com/Kkartik14/TVIC/issues"
  },
  "keywords": [
    "voice",
    "voice-ai",
    "ai-agent",
    "speech-to-text",
    "text-to-speech",
    "telephony",
    "webrtc",
    "tvic"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist dist-types .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tvic/core": "workspace:*",
    "@tvic/dal": "workspace:*",
    "@tvic/dal-composite": "workspace:*",
    "@tvic/dal-postgres": "workspace:*",
    "@tvic/dal-postgres-memory": "workspace:*",
    "@tvic/dal-redis": "workspace:*",
    "@tvic/media": "workspace:*",
    "@tvic/providers": "workspace:*",
    "@tvic/runtime": "workspace:*",
    "@tvic/tools": "workspace:*",
    "esbuild": "^0.28.0",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
