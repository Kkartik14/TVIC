{
  "name": "@tvic/runtime",
  "version": "0.1.0",
  "description": "T-vic runtime entrypoint with contract factories and an in-memory runtime lifecycle implementation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tvic/core": "workspace:*",
    "@tvic/dal": "workspace:*",
    "@tvic/media": "workspace:*",
    "@tvic/tools": "workspace:*",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
}
