{
  "name": "@tvic/dal-postgres-memory",
  "version": "0.1.0",
  "description": "PostgreSQL-backed durable memory for TVIC. Thin reference adapter (KV, no vector).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/generate-migration-bundles.mjs --target postgres-memory",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@tvic/core": "workspace:*",
    "@tvic/dal-codec": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
