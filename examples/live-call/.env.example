# Copy to the repository root as .env for local development.
PUBLIC_HOST=your-public-host.example
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional provider and gateway settings.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
STT_LANGUAGE=en
CARTESIA_MODEL=sonic-3.6
PORT=8080
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_MS=120000
TWILIO_AUTH_TOKEN=
# Create a Standard API key in Twilio Console for Calls API access. The Auth
# Token is also used to verify Twilio's signed HTTP and WebSocket callbacks.
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=+1...
TWILIO_TO_NUMBER=+1...
TWILIO_STATUS_PATH=/twilio/status
# Protects the example gateway's POST /calls/outbound endpoint. Use a random
# secret of at least 32 characters; never commit the live value.
TVIC_OUTBOUND_CALL_TOKEN=
TWILIO_LIVE_MAX_WAIT_MS=300000
TWILIO_LIVE_POLL_MS=3000
# The outbound runner still requires both --place-live-call and an interactive
# typed confirmation; leave this disabled until explicitly running a live call.
TVIC_ALLOW_LIVE_TWILIO_CALL=0
# Keep false unless this is a private development tunnel.
ALLOW_UNAUTHENTICATED_TWIML=false
TWIML_REPLAY_TTL_MS=300000
# Required in production for replay protection shared across gateway instances.
REDIS_URL=
