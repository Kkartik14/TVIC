# Copy to the repository root as .env for local development.
PUBLIC_HOST=your-public-host.example
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional provider and gateway settings.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
STT_LANGUAGE=en
CARTESIA_MODEL=sonic-3
PORT=8080
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_MS=120000
TWILIO_AUTH_TOKEN=
# Keep false unless this is a private development tunnel.
ALLOW_UNAUTHENTICATED_TWIML=false
TWIML_REPLAY_TTL_MS=300000
# Required in production for replay protection shared across gateway instances.
REDIS_URL=
