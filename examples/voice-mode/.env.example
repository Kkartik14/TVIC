# Copy this file to the repository root as .env for a no-credential local demo.
VOICE_PROVIDER_MODE=mock
# For live testing, use either openai (default) or groq.
VOICE_LLM_PROVIDER=openai
PORT=8090
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# These are generated local-development defaults when omitted. Set long random
# values for any shared or production deployment.
# VOICE_AUTH_SECRET=
# VOICE_ADMIN_SECRET=
# STREAM_TOKEN_SECRET=
# SAFETY_IDENTIFIER_SECRET=

# Switch to live providers only after setting all required provider credentials.
# VOICE_PROVIDER_MODE=live
# VOICE_LLM_PROVIDER=groq
# GROQ_API_KEY=replace-me-for-live-groq-testing
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_URL=https://api.groq.com/openai/v1/responses
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=

# Optional provider smoke-test credentials. Keep these in the ignored root .env
# during local development and never expose them to the browser.
# ASSEMBLYAI_API_KEY=
# SARVAM_API_KEY=
# SONIOX_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# CARTESIA_MODEL=sonic-3
# GROQ_MODEL=openai/gpt-oss-20b
